{
  "logical_id": "local-embed",
  "upstream_model_id": "google/embeddinggemma-300m",
  "role": "embeddings",
  "license": "gemma",
  "runtime": {
    "backend": "vllm",
    "port": 9402,
    "endpoint": "/v1/embeddings",
    "runner": "pooling",
    "max_model_len": 2048
  },
  "spec": {
    "max_input_tokens": 2048,
    "default_embedding_dimension": 768,
    "matryoshka_dimensions": [
      768,
      512,
      256,
      128
    ]
  },
  "sources": [
    "https://huggingface.co/google/embeddinggemma-300m",
    "https://docs.vllm.ai/en/latest/serving/openai_compatible_server/"
  ],
  "source_facts": {
    "model_size": "300M parameters",
    "license": "gemma",
    "access": "public repository with usage-license acceptance required for files and content",
    "max_input_tokens": 2048,
    "default_embedding_dimension": 768,
    "matryoshka_dimensions": [
      768,
      512,
      256,
      128
    ],
    "intended_runtime_from_card": "Sentence Transformers"
  },
  "project_runtime_policy": {
    "runner": "pooling",
    "max_model_len": 2048,
    "embedding_dimension_default": 768,
    "embedding_dimension_supported": [
      768,
      512,
      256,
      128
    ],
    "max_num_seqs": 2,
    "max_num_batched_tokens": 2048,
    "gpu_memory_utilization": 0.04,
    "policy_reason": "serve EmbeddingGemma through the platform embedding API while preserving model-card token and dimension limits"
  },
  "request_parameters": {
    "dimensions": {
      "type": "integer",
      "enum": [768, 512, 256, 128],
      "default": 768
    },
    "encoding_format": {
      "type": "string",
      "const": "float",
      "description": "현재 runtime profile에서 float만 지원한다. base64 encoding은 이 Gateway profile에서 지원하지 않는다."
    },
    "truncate_prompt_tokens": {
      "type": "integer",
      "one_of": [{"const": -1}, {"min": 1, "max": 2048}]
    },
    "user": {
      "type": "string",
      "description": "OpenAI API compatibility용 optional 식별자. accepted for compatibility. metric label로 사용하지 않는다. upstream 전달 여부는 runtime profile에 따른다.",
      "status": "accepted_for_compatibility"
    }
  },
  "openai_compatibility_surface": {
    "input_string": "supported",
    "input_string_array": "supported",
    "input_token_array": {
      "status": "not_supported",
      "reason": "현재 runtime profile에서 upstream vLLM embedding endpoint가 token-array input을 지원하지 않음. smoke 결과 기준으로 schema에서 명시적으로 제외한다."
    },
    "encoding_format_float": "supported",
    "encoding_format_base64": {
      "status": "not_supported",
      "reason": "이 Gateway profile에서 base64 encoding을 지원하지 않는다. upstream vLLM profile이 base64를 반환하지 않으며 Gateway에서 float32 LE bytes 변환을 구현하지 않은 상태다."
    },
    "user_field": "accepted_for_compatibility"
  },
  "embedding_prompt_policy": {
    "enabled": false,
    "version": "embeddinggemma-v1",
    "query_template": "task: search result | query: {text}",
    "document_template": "title: {title_or_none} | text: {text}",
    "requires_reindex_when_enabled": true,
    "note": "기본 비활성화. 활성화하면 기존 vector index와 embedding distribution이 바뀌므로 전체 재색인이 필요하다. 이번 릴리즈에서 기존 dense retrieval 동작을 바꾸지 않는다."
  },
  "retrieval": {
    "backend": "dense_embedding",
    "score_function": "cosine",
    "score_mode": "dense_cosine",
    "capabilities": [
      "retrieval_rerank",
      "retrieval_score"
    ]
  }
}
