{
  "logical_id": "local-main",
  "upstream_model_id": "QuantTrio/gemma-4-31B-it-AWQ",
  "base_model_id": "google/gemma-4-31B-it",
  "role": "main_chat_completion",
  "license": "apache-2.0",
  "runtime": {
    "backend": "vllm",
    "port": 9401,
    "endpoint": "/v1/chat/completions",
    "quantization": "awq",
    "configured_tensor_parallel_size": 1,
    "model_card_example_tensor_parallel_size": 2,
    "max_model_len": 8192,
    "python_default": "3.12.13",
    "max_output_tokens": 1024
  },
  "sources": [
    "https://huggingface.co/QuantTrio/gemma-4-31B-it-AWQ",
    "https://docs.vllm.ai/en/latest/models/supported_models/",
    "https://docs.vllm.ai/projects/recipes/en/latest/Google/Gemma4.html"
  ],
  "source_facts": {
    "base_model_id": "google/gemma-4-31B-it",
    "quantization": "AWQ 4-bit",
    "vllm_min_version": "0.19.0",
    "transformers_min_version": "5.5.0",
    "cuda_runtime_note": "cuda12.8 mentioned by upstream card as of 2026-04-03",
    "upstream_example": {
      "tensor_parallel_size": 2,
      "max_model_len": 32768,
      "max_num_seqs": 32,
      "gpu_memory_utilization": 0.9,
      "trust_remote_code": true,
      "enable_auto_tool_choice": true,
      "tool_call_parser": "gemma4",
      "reasoning_parser": "gemma4"
    },
    "supported_modalities": [
      "text",
      "image"
    ],
    "context_length_tokens": 262144
  },
  "project_runtime_policy": {
    "tensor_parallel_size": 1,
    "max_model_len": 8192,
    "max_num_seqs": 1,
    "max_num_batched_tokens": 4096,
    "gpu_memory_utilization": 0.58,
    "trust_remote_code": true,
    "policy_reason": "single-GPU service mix cap; not copied from the upstream multi-GPU example",
    "max_output_tokens": 1024,
    "input_modalities": [
      "text",
      "image"
    ],
    "chat_content_contract": "OpenAI chat content string or content parts with text and image_url",
    "max_image_inputs": 1,
    "allowed_image_url_schemes": [
      "data"
    ],
    "image_url_policy_reason": "avoid arbitrary server-side URL fetch by default; validate MIME, decoded image bytes, and image dimensions; external HTTPS image fetch should be enabled only behind an egress policy",
    "max_image_bytes": 750000,
    "max_image_pixels": 1048576,
    "allowed_image_mime_types": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "runtime_features": {
      "prefix_caching": {
        "enabled": true,
        "hash_algo": "sha256_cbor"
      },
      "tool_calling": {
        "enabled": true,
        "tool_call_parser": "gemma4",
        "reasoning_parser": "gemma4",
        "allow_parallel_tool_calls": false
      }
    },
    "request_parameter_policy": "bounded allowlist in configs/model_serving.yaml; unknown chat fields rejected at Gateway"
  }
}
