{
  "logical_id": "risk-prompt",
  "upstream_model_id": "kakaocorp/kanana-safeguard-prompt-2.1b",
  "role": "prompt_attack_signal_detector",
  "license": "apache-2.0",
  "runtime": {
    "backend": "vllm",
    "port": 9403,
    "internal_endpoint": "/v1/chat/completions",
    "public_adapter_endpoint": "/v1/risk/detectors/prompt/assessments",
    "max_output_tokens": 1
  },
  "spec": {
    "safe_label": "<SAFE>",
    "unsafe_pattern": "<UNSAFE-Ax>",
    "codes": [
      "A1",
      "A2"
    ],
    "languages": [
      "ko",
      "en"
    ]
  },
  "sources": [
    "https://huggingface.co/kakaocorp/kanana-safeguard-prompt-2.1b"
  ],
  "source_facts": {
    "single_label_token": true,
    "safe_label": "<SAFE>",
    "unsafe_pattern": "<UNSAFE-Ax>",
    "known_codes": [
      "A1",
      "A2"
    ],
    "languages": [
      "ko",
      "en"
    ],
    "transformers_min_version": "4.52.4",
    "model_card_max_new_tokens": 1,
    "evaluation_basis": "first generated token",
    "config_shape": {
      "model_type": "llama",
      "architecture": "LlamaForCausalLM",
      "hidden_size": 1792,
      "num_attention_heads": 24,
      "num_key_value_heads": 8,
      "head_dim": 128,
      "hidden_size_divisible_by_attention_heads": false,
      "attention_projection_width": 3072,
      "requires_runtime_head_dim_support": true
    }
  },
  "project_runtime_policy": {
    "max_output_tokens": 1,
    "temperature": 0,
    "prompt_format": "chat_template-compatible user message",
    "policy_reason": "model card는 1-token classification 출력을 정의하고, 예시 생성은 max_new_tokens=1을 사용한다",
    "runtime_features": {
      "tool_calling": {
        "enabled": false
      },
      "prefix_caching": {
        "enabled": false
      }
    }
  }
}
