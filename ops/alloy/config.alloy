// Gateway/Risk Adapter 요청 이벤트는 애플리케이션이 소유하는 고정 JSONL에서 읽는다.
// Docker container ID나 admin-sidecar의 target discovery와 무관한 신뢰 경로다.
loki.source.file "request_events" {
  targets = [
    {__path__ = "/var/lib/alloy/request-events/*.jsonl", job = "application"},
  ]
  forward_to    = [loki.process.request_events.receiver]
  tail_from_end = false

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.process "request_events" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {service = "service"}
  }

  stage.labels {
    values = {service = "service"}
  }
}

// Docker API 권한은 없다. admin-sidecar가 Compose metadata와 Docker LogPath로
// 만든 manifest는 third-party runtime/container 진단 로그에만 사용한다.
discovery.file "docker_targets" {
  files            = ["/var/lib/alloy/targets/docker-containers.json"]
  refresh_interval = "10s"
}

loki.source.file "docker_json" {
  targets       = discovery.file.docker_targets.targets
  forward_to    = [loki.process.docker_json.receiver]
  tail_from_end = true
}

loki.process "docker_json" {
  forward_to = [loki.write.local.receiver]

  stage.docker {}

  // docker json-file의 stdout/stderr 구분은 기존 Promtail label contract를 유지한다.
  stage.labels {
    values = {
      stream = "",
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
