      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Risk Signal Health",
      "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate owner/runbook. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(risk_signal_detected_total[$window])) by (risk_code)",
          "refId": "A",
          "legendFormat": "risk={{risk_code}}"
        },
        {
          "expr": "sum(rate(risk_adapter_system_signal_total[$window])) by (system_signal_code)",
          "refId": "B",
          "legendFormat": "signal={{system_signal_code}}"
        }
      ],
      "options": {
