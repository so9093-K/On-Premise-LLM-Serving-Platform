      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Gateway Input & Auth Issues",
      "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate owner/runbook. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(increase(request_validation_rejections_total{service=\"gateway\"}[$window])) by (reason)",
          "refId": "A",
          "legendFormat": "validation={{reason}}"
        },
        {
          "expr": "sum(increase(auth_failures_total{service=\"gateway\"}[$window])) by (reason)",
          "refId": "B",
          "legendFormat": "auth={{reason}}"
        }
      ],
      "options": {
        "legend": {
