              "expr": "histogram_quantile(0.50, sum by (le, route, model, backend, score_mode) (rate(retrieval_request_duration_seconds_bucket{service=\"gateway\"}[$window])))",
              "refId": "A",
              "legendFormat": "p50 {{route}} {{model}} {{score_mode}}"
            },
            {
              "expr": "histogram_quantile(0.95, sum by (le, route, model, backend, score_mode) (rate(retrieval_request_duration_seconds_bucket{service=\"gateway\"}[$window])))",
