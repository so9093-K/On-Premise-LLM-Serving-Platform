    {
      "id": 7,
      "type": "timeseries",
      "title": "Gateway vs Upstream p95",
      "description": "Healthy/정상: gateway and upstream p95 are both within SLO. Attention/주의: large gap between gateway and upstream p95 may indicate gateway overhead. No Data/런타임 데이터 없음: check Gateway scrape and upstream latency histogram. Uses path=~chat/completions(:stream)? for upstream.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"gateway\",route=\"/v1/chat/completions\"}[$window])) by (le))",
          "refId": "A",
          "legendFormat": "gateway chat p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(upstream_request_duration_seconds_bucket{service=\"gateway\",target=~\"$model\",path=~\"chat/completions(:stream)?\"}[$window])) by (le, target))",
          "refId": "B",
          "legendFormat": "upstream {{target}} p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      }
    },
