      "targets": [
        {
          "expr": "sum(increase(upstream_errors_total{service=\"gateway\",target=~\"$model\"}[$window])) or on() (sum(up{job=\"gateway\"}) * 0)",
          "refId": "A",
          "legendFormat": "model call failures"
        }
