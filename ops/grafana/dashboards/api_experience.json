      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Delay Details",
      "description": "Action: expand only when the snapshot indicates this detail is needed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "collapsed": true,
      "panels": [
        {
          "id": 2,
          "type": "stat",
          "title": "Chat Response Delay (p95)",
          "description": "Healthy/정상: p95 latency within SLO. Attention/주의: rising p95 before error rate often indicates runtime pressure. Action Required/조치 필요: p95 above 10s needs runtime drill-down. No Data/런타임 데이터 없음: check Prometheus scrape and gateway histogram.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 4
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"gateway\",route=\"/v1/chat/completions\"}[$window])) by (le))",
              "refId": "A",
              "legendFormat": "p95"
            }
          ],
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "center",
            "textMode": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 3,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 5.0
                  },
                  {
                    "color": "red",
                    "value": 10.0
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 3,
          "type": "stat",
          "title": "Slowest Chat Responses (p99)",
          "description": "Healthy/정상: p99 latency within SLO. Attention/주의: p99 higher than p95 by large margin may indicate tail-latency issues. Action Required/조치 필요: p99 above 10s needs immediate investigation. No Data/런타임 데이터 없음: check Prometheus scrape and gateway histogram.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 4
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"gateway\",route=\"/v1/chat/completions\"}[$window])) by (le))",
              "refId": "A",
              "legendFormat": "p99"
            }
          ],
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "center",
            "textMode": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 3,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 5.0
                  },
                  {
                    "color": "red",
                    "value": 10.0
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 7,
          "type": "timeseries",
          "title": "Delay Split: Gateway vs Model",
          "description": "Healthy/정상: gateway and upstream p95 are both within SLO. Attention/주의: large gap between gateway and upstream p95 may indicate gateway overhead. No Data/런타임 데이터 없음: check Gateway scrape and upstream latency histogram. Uses path=~chat/completions(:stream)? for upstream.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 12,
            "w": 12,
            "h": 6
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"gateway\",route=\"/v1/chat/completions\"}[$window])) by (le))",
              "refId": "A",
              "legendFormat": "gateway chat p95"
            },
            {
              "expr": "histogram_quantile(0.95, sum(rate(upstream_request_duration_seconds_bucket{service=\"gateway\",target=~\"$model\",path=~\"chat/completions(:stream)?\"}[$window])) by (le, target))",
              "refId": "B",
              "legendFormat": "upstream {{target}} p95"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 3
            },
            "overrides": []
          }
        },
        {
          "id": 105,
          "type": "timeseries",
          "title": "Average Delay: Gateway vs Model",
          "description": "Healthy/정상: average Gateway and model-call latency stay close and within SLO. Attention/주의: Gateway average above model average indicates Gateway overhead; model average rising indicates runtime pressure. No Data/런타임 데이터 없음: check Gateway scrape and upstream latency histogram.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 12,
            "w": 12,
            "h": 6
          },
          "targets": [
            {
              "expr": "sum(rate(http_request_duration_seconds_sum{service=\"gateway\",route=\"/v1/chat/completions\"}[$window])) / sum(rate(http_request_duration_seconds_count{service=\"gateway\",route=\"/v1/chat/completions\"}[$window]))",
              "refId": "A",
              "legendFormat": "gateway chat avg"
            },
            {
              "expr": "sum by (target) (rate(upstream_request_duration_seconds_sum{service=\"gateway\",target=~\"$model\",path=~\"chat/completions(:stream)?\"}[$window])) / sum by (target) (rate(upstream_request_duration_seconds_count{service=\"gateway\",target=~\"$model\",path=~\"chat/completions(:stream)?\"}[$window]))",
              "refId": "B",
              "legendFormat": "model {{target}} avg"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 3
            },
            "overrides": []
          }
        }
      ]
    },
