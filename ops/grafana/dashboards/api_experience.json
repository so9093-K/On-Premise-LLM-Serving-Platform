  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Activity",
      "description": "Healthy/정상: user traffic is present when expected. Attention/주의: 0 means idle, not failure, unless traffic is expected. No Data/런타임 데이터 없음: check Gateway scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"gateway\",route=\"/v1/chat/completions\"}[$window])) or on() (sum(up{job=\"gateway\"}) * 0)",
          "refId": "A",
          "legendFormat": "rps"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Chat Failures",
      "description": "Healthy/정상: 5xx ratio near zero. Attention/주의: above 1% needs triage. Action Required/조치 필요: above 5% means users are experiencing failures. No Data/런타임 데이터 없음: check Prometheus scrape and gateway request counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(increase(http_requests_total{service=\"gateway\",route=\"/v1/chat/completions\",status_code=~\"5..\"}[$window])) / clamp_min(sum(increase(http_requests_total{service=\"gateway\",route=\"/v1/chat/completions\"}[$window])), 1)) or on() (sum(up{job=\"gateway\"}) * 0)",
          "refId": "A",
          "legendFormat": "5xx ratio"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Streaming Failures",
      "description": "Healthy/정상: 0 streaming errors. Attention/주의: any errors need investigation. Action Required/조치 필요: sustained streaming errors with active traffic. No Data/런타임 데이터 없음: check Gateway scrape and streaming error counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(streaming_errors_total{service=\"gateway\",target=~\"$model\"}[$window])) or on() (sum(up{job=\"gateway\"}) * 0)",
          "refId": "A",
          "legendFormat": "errors"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Rejected Requests",
      "description": "Healthy/정상: 0 rejected requests. Attention/주의: non-zero validation or auth rejects. No Data/런타임 데이터 없음: check Gateway scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(increase(request_validation_rejections_total{service=\"gateway\"}[$window])) + sum(increase(auth_failures_total{service=\"gateway\"}[$window]))) or on() (sum(up{job=\"gateway\"}) * 0)",
          "refId": "A",
          "legendFormat": "rejected"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Model Call Failures",
      "description": "Healthy/정상: 0 model call failures. Attention/주의: non-zero upstream/model-call failures. No Data/런타임 데이터 없음: check Gateway scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
