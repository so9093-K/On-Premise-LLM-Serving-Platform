{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {"title": "Serving Home", "type": "link", "url": "/d/serving_home"}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "description": "Healthy when the request gate is 1. Action Required when it remains closed outside a planned switch.",
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "main_model_gate_open{service=\"gateway\"}", "refId": "A"}],
      "title": "Main-model Gate Open",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 8, "x": 4, "y": 0},
      "id": 2,
      "description": "Healthy identity evidence for the active allowlisted profile. No Data means Gateway has not projected Sidecar state.",
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "name", "wideLayout": true},
      "targets": [{"expr": "main_model_profile_info{service=\"gateway\"}", "legendFormat": "{{profile}} · {{compatibility}} · {{revision}}", "refId": "A"}],
      "title": "Active Profile / Revision / Compatibility",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 0},
      "id": 3,
      "description": "Healthy when completed or idle. Attention is required for failed and rollback_failed states.",
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "main_model_operation_state{service=\"gateway\"} == 1", "legendFormat": "{{state}}", "refId": "A"}],
      "title": "Latest Operation State",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 4,
      "description": "Switch and rollback totals restored from persistent state. Action: investigate failure growth.",
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "main_model_switch_operations{service=\"gateway\"}", "legendFormat": "{{result}}", "refId": "A"}],
      "title": "Switch / Rollback Totals",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 5,
      "description": "Last terminal switch duration. No Data means no switch has completed since metrics projection.",
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "main_model_last_switch_duration_seconds{service=\"gateway\"}", "legendFormat": "last switch", "refId": "A"}],
      "title": "Last Switch Duration",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["ai-model-serving", "runtime-control", "contract-reference"],
  "templating": {
    "list": [
      {
        "current": {"text": "Prometheus", "value": "prometheus"},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {"text": "5m", "value": "5m"},
        "hide": 0,
        "includeAll": false,
        "label": "Window",
        "multi": false,
        "name": "window",
        "options": [
          {"selected": true, "text": "5m", "value": "5m"},
          {"selected": false, "text": "15m", "value": "15m"},
          {"selected": false, "text": "1h", "value": "1h"}
        ],
        "query": "5m,15m,1h",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Main Model Control",
  "uid": "main_model_control",
  "version": 1
}
