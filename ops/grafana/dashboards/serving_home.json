    {
      "id": 101,
      "type": "row",
      "title": "Evidence Details",
      "description": "Action: expand only when the snapshot indicates this detail is needed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "collapsed": true,
      "panels": [
        {
          "id": 9,
          "type": "stat",
          "title": "Lowest GPU Safety Margin",
          "description": "Healthy/정상: minimum over selected range stays above 5 GiB. Attention/주의: 4-5 GiB means pressure may have occurred. Action Required/조치 필요: below 4 GiB indicates OOM risk. No Data/런타임 데이터 없음: GPU exporter absent.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "min_over_time(gpu_memory_headroom_bytes[$__range])",
              "refId": "A",
              "legendFormat": "min headroom"
            }
          ],
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "center",
            "textMode": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "decimals": 1,
              "noValue": "GPU Exporter Absent",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 4294967296
                  },
                  {
                    "color": "green",
                    "value": 5368709120
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 10,
          "type": "stat",
          "title": "Highest Model Capacity Used",
          "description": "Healthy/정상: max KV pressure stays below 0.8 in range. Attention/주의: 0.8-0.9 is elevated. Action Required/조치 필요: above 0.9 can precede OOM. No Data/런타임 데이터 없음: vLLM KV metric absent.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "max_over_time(vllm_kv_cache_usage_ratio{model=~\"$model\",runtime_service=~\"$runtime_service\"}[$__range])",
              "refId": "A",
              "legendFormat": "max KV"
            }
          ],
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "center",
            "textMode": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "decimals": 2,
              "min": 0,
              "max": 1,
              "noValue": "vLLM Absent",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 0.8
                  },
                  {
                    "color": "red",
                    "value": 0.9
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 11,
          "type": "stat",
          "title": "Crash and Restart Signals",
          "description": "Healthy/정상: 0 OOM events and 0 restart signals in selected range when cAdvisor scrape is green. Action Required/조치 필요: any value above 0 requires GPU Capacity and OOM Risk drill-down. No Data/런타임 데이터 없음: cAdvisor source metric absent — do not read No Data as 0.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$__range]))",
              "refId": "A",
              "legendFormat": "oom events"
            },
            {
              "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$__range]))",
              "refId": "B",
              "legendFormat": "restart signals"
            }
          ],
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "center",
            "textMode": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "cAdvisor Absent",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 12,
          "type": "timeseries",
          "title": "GPU Memory Used vs Budget",
          "description": "Healthy/정상: observed live VRAM remains under the current guide lines. Attention/주의: 43-44.5GiB means the configured reserve is thinning. No Data/런타임 데이터 없음: DCGM memory metrics absent. GPU warm residency during idle is normal — high VRAM used at idle is expected.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "DCGM_FI_DEV_FB_USED * 1024 * 1024",
              "refId": "A",
              "legendFormat": "used"
            },
            {
              "expr": "DCGM_FI_DEV_FB_TOTAL * 1024 * 1024",
              "refId": "B",
              "legendFormat": "total"
            },
            {
              "expr": "vector(43 * 1024 * 1024 * 1024)",
              "refId": "C",
              "legendFormat": "43 GiB guide"
            },
            {
              "expr": "vector(44.5 * 1024 * 1024 * 1024)",
              "refId": "D",
              "legendFormat": "44.5 GiB hard-floor guide"
            }
          ],
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            },
            "overrides": []
          }
        },
        {
          "id": 13,
          "type": "timeseries",
          "title": "Waiting Requests",
          "description": "Healthy/정상: queue remains near zero at idle and follows traffic under load. Attention/주의: rising queue before latency impact indicates runtime saturation. No Data/런타임 데이터 없음: vLLM metric absent.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 6,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "vllm_queue_depth{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
              "refId": "A",
              "legendFormat": "{{model}}"
            }
          ],
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          }
        },
        {
          "id": 14,
          "type": "timeseries",
          "title": "Model Capacity Used",
          "description": "Healthy/정상: KV pressure below 0.8 at idle. Attention/주의: sustained high pressure can precede OOM. No Data/런타임 데이터 없음: vLLM KV metric absent.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 6,
            "y": 6,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "vllm_kv_cache_usage_ratio{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
              "refId": "A",
              "legendFormat": "{{model}}"
            }
          ],
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1
            },
            "overrides": []
          }
        },
        {
          "id": 15,
          "type": "timeseries",
          "title": "Token Throughput",
          "description": "Healthy/정상: prompt+generation tokens follow user traffic. Attention/주의: token throughput without user traffic may be background activity. No Data/런타임 데이터 없음: vLLM token metric absent.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 6,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "vllm_token_throughput_per_second{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
              "refId": "A",
              "legendFormat": "{{model}}"
            }
          ],
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "suffix: tok/s"
            },
            "overrides": []
          }
        },
        {
          "id": 16,
          "type": "timeseries",
          "title": "GPU Workload",
          "description": "Healthy/정상: low utilization at idle is expected. Attention/주의: high utilization without user traffic needs review. No Data/런타임 데이터 없음: GPU exporter absent.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 18,
            "y": 6,
            "w": 6,
            "h": 6
          },
          "targets": [
            {
              "expr": "gpu_utilization_ratio",
              "refId": "A",
              "legendFormat": "gpu utilization"
            }
          ],
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit"
            },
            "overrides": []
          }
        }
      ]
    }
  ],
