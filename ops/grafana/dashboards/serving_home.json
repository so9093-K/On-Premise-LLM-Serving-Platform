  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Verdict",
      "description": "Healthy/정상: HEALTHY ACTIVE (code 4) or IDLE WARM (code 3) means the stack is ready. Attention/주의: IDLE COLD (code 2) or OBSERVABILITY DEGRADED (code 5) needs triage. Action Required/조치 필요: USER IMPACT (code 7) or CAPACITY RISK (code 6) requires immediate drill-down. No Data/런타임 데이터 없음: verdict recording rule absent — check observability_data_quality.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "expr": "ai_serving_verdict_code",
          "refId": "A",
          "legendFormat": "verdict"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "IDLE COLD",
                  "color": "yellow"
                },
                "3": {
                  "text": "IDLE WARM",
                  "color": "blue"
                },
                "4": {
                  "text": "HEALTHY ACTIVE",
                  "color": "green"
                },
                "5": {
                  "text": "OBSERVABILITY DEGRADED",
                  "color": "orange"
                },
                "6": {
                  "text": "CAPACITY RISK",
                  "color": "orange"
                },
                "7": {
                  "text": "USER IMPACT",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA",
                  "color": "gray"
                }
              }
            }
          ],
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "blue",
                "value": 3
              },
              {
                "color": "green",
                "value": 4
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 7
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Serving State",
      "description": "Healthy/정상: overall_runtime_status and service_readiness_status are 1. Action Required/조치 필요: 0 means a readiness path failed. No Data/런타임 데이터 없음: readiness metric absent or scrape down — do not read No Data as 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(overall_runtime_status)",
          "refId": "A",
          "legendFormat": "runtime"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not Ready",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "User Requests",
      "description": "Healthy/정상: non-zero means active user sessions. Attention/주의: 0 is blue (not red) — idle is normal. No Data/런타임 데이터 없음: gateway scrape is missing; 0 is suppressed when exporter is absent so this shows No Data rather than false zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{service=\"gateway\",route=~\"$user_route\",route!~\"/health|/ready|/v1/models|/metrics|/docs|/openapi.json\"}[$window])) or on() (sum(up{job=\"gateway\"}) * 0)",
          "refId": "A",
          "legendFormat": "user requests"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Metric Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Monitoring Coverage",
      "description": "Healthy/정상: visible count equals 8 expected. Attention/주의: below 8 means a target is missing or misconfigured — open Observability / Data Quality. No Data/런타임 데이터 없음: Prometheus up series absent. The expected critical target count is projected from gateway + risk-adapter + vLLM runtime targets + dcgm + cadvisor.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(up{job=~\"gateway|risk-adapter|vllm-runtimes|dcgm-exporter|cadvisor\"})",
          "refId": "A",
          "legendFormat": "visible"
        },
        {
          "expr": "sum(up{job=~\"gateway|risk-adapter|vllm-runtimes|dcgm-exporter|cadvisor\"})",
          "refId": "B",
          "legendFormat": "up"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No Target Data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "green",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "GPU Safety Margin",
      "description": "Healthy/정상: selected-range minimum observed headroom stays above 5GiB. Attention/주의: 4-5GiB means reserve tightened during the window. Action Required/조치 필요: below 4GiB is red. No Data/런타임 데이터 없음: GPU exporter absent — do not read No Data as zero headroom.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min_over_time(gpu_memory_headroom_bytes[$__range])",
          "refId": "A",
          "legendFormat": "min headroom"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "noValue": "GPU Exporter Absent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 4294967296
              },
              {
                "color": "green",
                "value": 5368709120
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Crashes and Restarts",
      "description": "Healthy/정상: 0 OOM events and 0 container start-time changes when cAdvisor scrape is green. Action Required/조치 필요: any value above 0 requires drill-down to GPU Capacity and OOM Risk. No Data/런타임 데이터 없음: cAdvisor source metric absent — do not read No Data as 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$window]))",
          "refId": "A",
          "legendFormat": "oom events"
        },
        {
          "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$window]))",
          "refId": "B",
          "legendFormat": "restart signals"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "cAdvisor Absent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Model Capacity",
      "description": "Healthy/정상: max KV cache pressure near zero at idle. Attention/주의: KV above 0.8. Action Required/조치 필요: KV above 0.9 — OOM risk. No Data/런타임 데이터 없음: vLLM metric absent — check vllm-runtimes scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max_over_time(vllm_kv_cache_usage_ratio{model=~\"$model\",runtime_service=~\"$runtime_service\"}[$__range])",
          "refId": "A",
          "legendFormat": "max KV"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "noValue": "vLLM Absent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Attention Needed",
      "description": "Healthy/정상: all signals below threshold — no action needed. Attention/주의: orange rows need monitoring. Action Required/조치 필요: red rows need immediate drill-down. No Data in a row means the exporter for that signal is absent — open Observability / Data Quality to diagnose.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "label_replace(label_replace((count(up{job=~\"gateway|risk-adapter|vllm-runtimes|dcgm-exporter|cadvisor\"}) or vector(0)), \"area\", \"Observability\", \"\", \"\"), \"suggested_action\", \"Open: Observability / Data Quality\", \"\", \"\")",
          "instant": true,
          "refId": "A",
          "legendFormat": "Systems Visible"
        },
        {
          "expr": "label_replace(label_replace((min_over_time(gpu_memory_headroom_bytes[$__range])), \"area\", \"GPU Capacity\", \"\", \"\"), \"suggested_action\", \"Open: GPU Capacity and OOM Risk\", \"\", \"\")",
          "instant": true,
          "refId": "B",
          "legendFormat": "Lowest GPU Safety Margin (bytes)"
        },
        {
          "expr": "label_replace(label_replace((sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$__range])) or vector(0)), \"area\", \"Crashes and Restarts\", \"\", \"\"), \"suggested_action\", \"Open: GPU Capacity and OOM Risk\", \"\", \"\")",
          "instant": true,
          "refId": "C",
          "legendFormat": "Crashes and Restarts Events"
        },
        {
          "expr": "label_replace(label_replace((sum(increase(http_requests_total{service=\"gateway\",route=~\"/v1/chat/completions|/v1/embeddings|/v1/risk/.*\",route!~\"/health|/ready|/v1/models|/metrics|/docs|/openapi.json\"}[$__range])) or on() (sum(up{job=\"gateway\"}) * 0)), \"area\", \"User Requests\", \"\", \"\"), \"suggested_action\", \"No action if idle expected. Open: API Experience if 5xx present.\", \"\", \"\")",
          "instant": true,
          "refId": "D",
          "legendFormat": "User Requests in Range"
        },
        {
          "expr": "label_replace(label_replace((max_over_time(vllm_kv_cache_usage_ratio{model=~\"$model\",runtime_service=~\"$runtime_service\"}[$__range]) or vector(0)), \"area\", \"Model Capacity\", \"\", \"\"), \"suggested_action\", \"Open: Model Runtime Deep Dive\", \"\", \"\")",
          "instant": true,
          "refId": "E",
          "legendFormat": "Max KV Cache Pressure"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "rows",
            "valueLabel": "area"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "model": true,
              "runtime_service": true
            },
            "renameByName": {
              "area": "Area",
              "suggested_action": "Suggested Action",
              "Value": "Current Value",
              "Metric": "Signal"
            },
            "indexByName": {
              "area": 0,
              "suggested_action": 1,
              "Value": 2
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "color-background"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Systems Visible"
