          "legendFormat": "{{model}} {{runtime_service}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Token Throughput",
      "description": "Healthy: throughput follows user traffic. Attention: throughput without user traffic may be background activity. No Data: vLLM token metric absent.",
