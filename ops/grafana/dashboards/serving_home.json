    {
      "id": 11,
      "type": "stat",
      "title": "Container OOM / Restart Signals",
      "description": "Healthy: 0 OOM events and 0 restart signals in selected range when cAdvisor scrape is green. Action Required: any value above 0 requires GPU Capacity and OOM Risk drill-down. No Data: cAdvisor source metric absent — do not read No Data as 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|risk-prompt-vllm\"}[$__range]))",
          "refId": "A",
          "legendFormat": "oom events"
        },
        {
          "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|risk-prompt-vllm\"}[$__range]))",
          "refId": "B",
          "legendFormat": "restart signals"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "cAdvisor Absent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "VRAM Used vs Budget",
      "description": "Healthy: used VRAM remains under budget lines. Attention: approaching 40-43 GiB budget lines. No Data: DCGM memory metrics absent. GPU warm residency during idle is normal — high VRAM used at idle is expected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED * 1024 * 1024",
          "refId": "A",
          "legendFormat": "used"
        },
        {
          "expr": "DCGM_FI_DEV_FB_TOTAL * 1024 * 1024",
          "refId": "B",
          "legendFormat": "total"
        },
        {
          "expr": "vector(40 * 1024 * 1024 * 1024)",
          "refId": "C",
          "legendFormat": "40 GiB budget"
        },
        {
          "expr": "vector(43 * 1024 * 1024 * 1024)",
          "refId": "D",
          "legendFormat": "43 GiB budget"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "vLLM Queue Depth",
      "description": "Healthy: queue remains near zero at idle and follows traffic under load. Attention: rising queue before latency impact indicates runtime saturation. No Data: vLLM metric absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm_queue_depth{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
          "refId": "A",
          "legendFormat": "{{model}} {{runtime_service}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "KV Cache Pressure",
      "description": "Healthy: KV pressure below 0.8 at idle. Attention: sustained high pressure can precede OOM. No Data: vLLM KV metric absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm_kv_cache_usage_ratio{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
