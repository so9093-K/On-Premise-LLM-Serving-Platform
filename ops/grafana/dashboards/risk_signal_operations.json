      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": true,
      "panels": [
        {
          "id": 5,
          "type": "barchart",
          "title": "Risk Types",
          "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate the owning service. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 6
          },
          "targets": [
            {
              "expr": "sum(increase(risk_signal_detected_total[$window])) by (risk_code)",
              "refId": "A",
              "legendFormat": "{{risk_code}}"
            }
          ],
          "options": {},
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          }
        },
        {
          "id": 6,
          "type": "barchart",
          "title": "System Signals",
          "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate the owning service. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 6
          },
          "targets": [
            {
              "expr": "sum(increase(risk_adapter_system_signal_total[$window])) by (system_signal_code)",
              "refId": "A",
              "legendFormat": "{{system_signal_code}}"
            }
          ],
          "options": {},
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          }
        },
        {
          "id": 9,
          "type": "barchart",
          "title": "Unsafe Fields by Name",
          "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate the owning service. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 6,
            "w": 12,
            "h": 6
          },
          "targets": [
            {
              "expr": "sum(increase(forbidden_response_field_total[$window])) by (field)",
              "refId": "A",
              "legendFormat": "{{field}}"
            }
          ],
          "options": {},
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          }
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "Detector Signals Over Time",
          "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate the owning service. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 6,
            "w": 12,
            "h": 6
          },
          "targets": [
            {
              "expr": "sum(rate(risk_adapter_system_signal_total[$window])) by (system_signal_code)",
              "refId": "A",
              "legendFormat": "{{system_signal_code}}"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          }
        }
      ]
    }
  ],
