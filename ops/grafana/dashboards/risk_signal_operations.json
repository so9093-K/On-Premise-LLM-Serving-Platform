  "liveNow": false,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Risk Snapshot",
      "description": "Action: read detector availability, risk-check volume, timeouts, unsafe fields, and response delay.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "**Risk snapshot** · detector availability, check volume, timeouts, unsafe fields, and delay."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Detector Availability",
      "description": "Healthy/정상: 1 = Ready (detector is up). Action Required/조치 필요: 0 = Not Ready — check risk-adapter logs and upstream detector. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(service_readiness_status{service=\"risk-adapter\"})",
          "refId": "A",
          "legendFormat": "ready"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not Ready",
                  "index": 0
                },
                "1": {
                  "text": "Ready",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Risk Checks",
      "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate the owning service. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(risk_assessments_total[$window]))",
          "refId": "A",
          "legendFormat": "rps"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Risk Detections",
      "description": "Risk detection ratio for the window (detected / total assessments). Healthy/정상: low baseline ratio. Attention/주의: ratio > 30%. Action Required/조치 필요: ratio > 70% or sudden spike. No Data/런타임 데이터 없음: check risk-adapter scrape. Shows ratio only — for total volume see Risk Checks; for count by risk type see Risk Types below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(risk_signal_detected_total[$window])) / clamp_min(sum(increase(risk_assessments_total[$window])), 1)",
          "refId": "A",
          "legendFormat": "detected ratio"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Risk Check Timeouts",
      "description": "INFERENCE_TIMEOUT events as ratio of total assessments. Healthy/정상: < 5%. Attention/주의: 5–10%. Action Required/조치 필요: > 10% — check detector upstream latency and Detector Availability. No Data/런타임 데이터 없음: check risk-adapter scrape. Shows ratio only — for count by signal type see System Signals below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(risk_adapter_system_signal_total{system_signal_code=\"INFERENCE_TIMEOUT\"}[$window])) / clamp_min(sum(increase(risk_assessments_total[$window])), 1)",
          "refId": "A",
          "legendFormat": "timeout ratio"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unsafe Response Fields",
      "description": "Healthy/정상: 0 (no signal-only contract violations). Action Required/조치 필요: any violation > 0 — investigate immediately, this indicates a prompt/output field exposure risk. No Data/런타임 데이터 없음: check risk-adapter scrape. 0 = metric registered and no violations (safe). The metric forbidden_response_field_total is always registered when risk-adapter is up, so 0 means no violations occurred.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(forbidden_response_field_total[$window])) or vector(0)",
          "refId": "A",
          "legendFormat": "violations"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Risk Check Delay (p95)",
      "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate the owning service. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(risk_assessment_duration_seconds_bucket[$window])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3.0
              },
              {
                "color": "red",
                "value": 5.0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Risk Details",
      "description": "Action: expand for detailed investigation when the snapshot cards point here.",
      "datasource": {
        "type": "prometheus",
