{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Serving Home",
      "tooltip": "Serving Home — operator triage surface with verdict, evidence, and drill-down",
      "type": "link",
      "url": "/d/serving_home/serving-home"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 8,
      "type": "stat",
      "title": "Detector Availability",
      "description": "Healthy/정상: 1 = Ready (detector is up). Action Required/조치 필요: 0 = Not Ready — check risk-adapter logs and upstream detector. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(service_readiness_status{service=\"risk-adapter\"})",
          "refId": "A",
          "legendFormat": "ready"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not Ready",
                  "index": 0
                },
                "1": {
                  "text": "Ready",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Risk Checks",
      "description": "Healthy/정상: risk checks appear when risk traffic is expected. Attention/주의: 0 means idle unless risk traffic is expected. No Data/런타임 데이터 없음: check risk-adapter scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(risk_assessments_total[$window]))",
          "refId": "A",
          "legendFormat": "rps"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Risk Check Timeouts",
      "description": "INFERENCE_TIMEOUT events as ratio of total assessments. Healthy/정상: < 5%. Attention/주의: 5–10%. Action Required/조치 필요: > 10% — check detector upstream latency and Detector Availability. No Data/런타임 데이터 없음: check risk-adapter scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(increase(risk_adapter_system_signal_total{system_signal_code=\"INFERENCE_TIMEOUT\"}[$window])) / clamp_min(sum(increase(risk_assessments_total[$window])), 1)) or on() (sum(up{job=\"risk-adapter\"}) * 0)",
          "refId": "A",
          "legendFormat": "timeout ratio"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Risk Check Delay (p95)",
      "description": "Healthy/정상: expected range. Attention/주의: review trend. Action Required/조치 필요: investigate the owning service. No Data/런타임 데이터 없음: check Prometheus scrape/exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(risk_assessment_duration_seconds_bucket[$window])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3.0
              },
              {
                "color": "red",
                "value": 5.0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "A1 Detections",
      "description": "Healthy/정상: 0 A1 detections in the selected window. Attention/주의: non-zero A1 detections indicate prompt-attack risk activity. No Data/런타임 데이터 없음: check risk-adapter scrape.",
