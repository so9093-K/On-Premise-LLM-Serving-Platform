{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU Headroom",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(gpu_memory_headroom_bytes)",
          "refId": "A",
          "legendFormat": "headroom"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "DCGM이 관측한 실제 GPU headroom입니다. admission plan이나 설정상 VRAM 비율과 혼용하지 않습니다. 정책 판단은 Gateway /admin/runtimes의 budget과 configs/gpu_budgets.yaml을 함께 확인합니다. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU Memory Used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(gpu_memory_used_bytes)",
          "refId": "A",
          "legendFormat": "used"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "DCGM이 관측한 실제 GPU VRAM 사용량입니다. 이 값은 vLLM admission plan의 예약 비율과 같을 필요가 없습니다. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "GPU Utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(gpu_utilization_ratio)",
          "refId": "A",
          "legendFormat": "util"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: active traffic in range. Attention: consistently high with low headroom. Action Required: saturated with queue backlog. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "GPU Temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(gpu_temperature_celsius)",
          "refId": "A",
          "legendFormat": "temp"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: normal operating range. Attention: rising trend — review cooling. Action Required: thermal throttling risk. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "GPU Power",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(gpu_power_watts)",
          "refId": "A",
          "legendFormat": "watts"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: normal range. Attention: sustained high — review workload. Action Required: investigate owner/runbook. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OOM / Restarts",
      "description": "Healthy: 0 — no container OOM or restart events. Action Required: any value > 0 — check container logs immediately. No Data: cAdvisor scrape absent; do not read as 0. Source: container_oom_events_total + container_start_time_seconds changes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$window])) + sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$window]))",
          "refId": "A",
          "legendFormat": "events"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Actual GPU VRAM",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{} * 1024 * 1024",
          "refId": "A",
          "legendFormat": "used gpu{{gpu_index}}"
        },
        {
          "expr": "DCGM_FI_DEV_FB_TOTAL{} * 1024 * 1024",
          "refId": "B",
          "legendFormat": "total gpu{{gpu_index}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "DCGM이 관측한 실제 VRAM 사용량과 총량입니다. 고정 capacity 기준선이나 설정상 admission plan을 겹쳐 표시하지 않습니다. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "vLLM Queue Depth",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm_queue_depth{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: near 0. Attention: > 20 — throughput may be constrained. Action Required: > 50 — reduce concurrency or scale. No Data: check vllm-runtimes scrape."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "KV Cache Pressure",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm_kv_cache_usage_ratio{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: < 0.8. Attention: 0.8–0.9 — monitor closely. Action Required: > 0.9 — OOM eviction risk. No Data: check vllm-runtimes scrape."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token Throughput per Model",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm_token_throughput_per_second{model=~\"$model\",runtime_service=~\"$runtime_service\"}",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Healthy: visible prompt+generation token throughput during active traffic. Attention: sudden drop without traffic decrease. Action Required: near zero with active requests. No Data: check vllm-runtimes scrape."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container System RAM per Model",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm_container_memory_usage_bytes{container_label_com_docker_compose_service=~\"$runtime_service\"}",
          "refId": "A",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Healthy: stable trend. Attention: growing unbounded over time. Action Required: spike near host RAM limit. No Data: check cAdvisor scrape."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU Cores Used per Model",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "vllm_container_cpu_cores_used{container_label_com_docker_compose_service=~\"$runtime_service\"}",
          "refId": "A",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cores",
          "decimals": 3
        },
        "overrides": []
      },
      "description": "Healthy: normal core usage. Attention: sustained high core usage. Action Required: high cores used while GPU work is blocked. No Data: check cAdvisor scrape."
    }
  ],
