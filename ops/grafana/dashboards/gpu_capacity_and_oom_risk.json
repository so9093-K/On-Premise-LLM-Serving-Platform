    {
      "id": 3,
      "type": "stat",
      "title": "Container OOM or Restart Signals",
      "description": "Healthy/정상: 0 container OOM events and 0 container start-time changes when cAdvisor scrape health is green. Action Required/조치 필요: any value > 0. No Data/런타임 데이터 없음: cAdvisor source metrics may be absent; do not read No Data as 0. Source metrics: container_oom_events_total and container_start_time_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|risk-prompt-vllm\"}[$window]))",
          "refId": "A",
          "legendFormat": "container start-time changes"
        },
        {
          "expr": "sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|risk-prompt-vllm\"}[$window]))",
          "refId": "B",
          "legendFormat": "container oom events"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
