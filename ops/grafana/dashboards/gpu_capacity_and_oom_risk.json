  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU Headroom",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(gpu_memory_headroom_bytes)",
          "refId": "A",
          "legendFormat": "headroom"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 4294967296
              },
              {
                "color": "green",
                "value": 6442450944
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: > 6GiB. Attention: 4–6GiB — watch trend. Action Required: < 4GiB — reduce max_tokens or concurrency. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU Memory Used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(gpu_memory_used_bytes)",
          "refId": "A",
          "legendFormat": "used"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 42949672960
              },
              {
                "color": "red",
                "value": 46170898432
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: < 40GiB. Attention: 40–43GiB — approaching budget. Action Required: > 43GiB — reduce load. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "GPU Utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(gpu_utilization_ratio)",
          "refId": "A",
          "legendFormat": "util"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: active traffic in range. Attention: consistently high with low headroom. Action Required: saturated with queue backlog. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "GPU Temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(gpu_temperature_celsius)",
          "refId": "A",
          "legendFormat": "temp"
