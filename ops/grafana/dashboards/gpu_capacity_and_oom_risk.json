              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Healthy: normal range. Attention: sustained high — review workload. Action Required: investigate owner/runbook. No Data: check dcgm-exporter scrape."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OOM / Restarts",
      "description": "Healthy: 0 — no container OOM or restart events. Action Required: any value > 0 — check container logs immediately. No Data: cAdvisor scrape absent; do not read as 0. Source: container_oom_events_total + container_start_time_seconds changes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$window])) + sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-adapter|main-llm-vllm|embedding-vllm|embedding-ko-vllm|risk-prompt-vllm\"}[$window]))",
          "refId": "A",
          "legendFormat": "events"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "VRAM Used vs Budget",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{} * 1024 * 1024",
          "refId": "A",
          "legendFormat": "used gpu{{gpu_index}}"
        },
        {
          "expr": "DCGM_FI_DEV_FB_TOTAL{} * 1024 * 1024",
          "refId": "B",
          "legendFormat": "total gpu{{gpu_index}}"
        },
        {
          "expr": "vector(40 * 1024 * 1024 * 1024)",
          "refId": "C",
          "legendFormat": "warning 40GiB"
        },
        {
          "expr": "vector(43 * 1024 * 1024 * 1024)",
          "refId": "D",
          "legendFormat": "action 43GiB"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Trend view. warning=40GiB and action=43GiB reference lines shown. Healthy: stable below 40GiB. Attention: approaching 40GiB. Action Required: above 43GiB. No Data: check dcgm-exporter scrape."
    },
    {
