    {
      "id": 8,
      "type": "timeseries",
      "title": "Streaming Chunk Rate",
      "description": "Healthy/정상: chunks/sec increasing with traffic. Attention/주의: chunk rate drops while request rate holds. Action Required/조치 필요: chunk rate near zero with active streaming requests. No Data/런타임 데이터 없음: check Gateway scrape and streaming code path.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
