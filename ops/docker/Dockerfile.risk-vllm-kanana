# Kanana risk-detector vLLM image.
#
# Keep this separate from the main Gemma4 runtime image. Kanana Safeguard-Prompt
# 2.1B uses an explicit Llama head_dim (hidden_size=1792, num_attention_heads=24,
# head_dim=128). Some Transformers/vLLM combinations reject this config when
# Llama architecture validation ignores explicit head_dim. This image keeps the
# workaround isolated from the main Gemma4 runtime and records patch metadata.
ARG BASE_IMAGE=vllm/vllm-openai:gemma4-0505-cu129
FROM ${BASE_IMAGE}

ARG TRANSFORMERS_MIN_VERSION=4.52.4
ARG PATCH_ID=transformers_llama_head_dim_guard

LABEL org.opencontainers.image.title="ai-model-serving-risk-vllm-kanana"
LABEL org.opencontainers.image.description="vLLM runtime image for Kakao Kanana safeguard risk detectors with explicit Transformers head_dim patch metadata"
LABEL ai_model_serving.patch.transformers_llama_head_dim_guard="true"
LABEL ai_model_serving.patch.reason="Kanana explicit head_dim compatibility"
LABEL ai_model_serving.patch.remove_when="Upstream Transformers/vLLM honors explicit Llama head_dim without image patch"
LABEL ai_model_serving.patch.metadata_path="/usr/local/share/ai-model-serving/patches/transformers_llama_head_dim_guard.json"
LABEL ai_model_serving.transformers_min_version="${TRANSFORMERS_MIN_VERSION}"

COPY ops/patches/transformers_llama_head_dim_guard.py /usr/local/bin/transformers_llama_head_dim_guard.py

# The build script passes TRANSFORMERS_MIN_VERSION as a lower-bound guard. The
# base image may ship a newer Transformers release, but the image must not fall
# below the known Kanana compatibility floor.
RUN python3 - <<'PY'
from __future__ import annotations

import os
import sys

import transformers

minimum = os.environ.get("TRANSFORMERS_MIN_VERSION", "4.52.4")
actual = transformers.__version__


def parse(value: str) -> tuple[int, int, int]:
    core = value.split("+", 1)[0].split("-", 1)[0]
    parts = core.split(".")[:3]
    nums = []
    for part in parts:
        digits = "".join(ch for ch in part if ch.isdigit())
        nums.append(int(digits or 0))
    while len(nums) < 3:
        nums.append(0)
    return tuple(nums)

if parse(actual) < parse(minimum):
    print(f"transformers {actual} is below Kanana minimum {minimum}", file=sys.stderr)
    sys.exit(1)
print(f"risk-vllm-kanana transformers={actual} minimum={minimum}")
PY

# Apply an auditable patch instead of keeping inline site-packages edits in this
# Dockerfile. The script records file hashes and package versions as JSON.
RUN python3 /usr/local/bin/transformers_llama_head_dim_guard.py --json \
    && python3 /usr/local/bin/transformers_llama_head_dim_guard.py --verify --json

RUN python3 - <<'PY'
import huggingface_hub
import transformers
print("risk-vllm-kanana transformers=", transformers.__version__)
print("risk-vllm-kanana huggingface_hub=", huggingface_hub.__version__)
PY
