# 주의: 이 파일을 그대로 .env로 복사하지 말고 반드시 `make init-env-compose`로 실제 .env를 생성한다.
# 기본 auth profile은 신뢰된 사내망용 local_open이며 전체 stack을 host-publish한다.
APP_ENV=local
PROJECT_VERSION=0.0.1
PYTHON_VERSION=3.12.13
BUILD_PROFILE=compose
LOG_LEVEL=INFO
# Stable Compose resource namespace. Use a unique value when multiple installations share one Docker host.
COMPOSE_PROJECT_NAME=compose

# API 문서 UX: Scalar/ReDoc/OpenAPI는 기본 활성화한다.
FASTAPI_DOCS_ENABLED=true
FASTAPI_DOCS_URL=/docs
FASTAPI_REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9400
# Host publish bind for ops/compose/full-stack.private-network.yaml.
# Prefer the 175 internal interface IP in shared/staging environments.
GATEWAY_BIND_ADDR=0.0.0.0
RISK_ADAPTER_HOST=0.0.0.0
RISK_ADAPTER_PORT=9405

# Compose profile: ops/compose/full-stack.private-network.yaml의 service name을 사용한다.
MAIN_LLM_BASE_URL=http://main-llm-vllm:9401/v1
EMBEDDING_BASE_URL=http://embedding-vllm:9402/v1
EMBEDDING_KO_BASE_URL=http://embedding-ko-vllm:9406/v1
RISK_PROMPT_BASE_URL=http://risk-prompt-vllm:9403/v1
RISK_ADAPTER_BASE_URL=http://risk-adapter:9405

MAIN_LLM_MODEL=local-main
MAIN_LLM_BOOT_PROFILE=gemma4-26b-a4b-fp8
MAIN_LLM_PROFILE_LOCKED=false
EMBEDDING_MODEL=local-embed
EMBEDDING_KO_MODEL=local-embed-ko
RISK_PROMPT_MODEL=risk-prompt

REQUEST_TIMEOUT_SECONDS=125
RISK_ADAPTER_TIMEOUT_SECONDS=15
VLLM_TIMEOUT_SECONDS=20
MAIN_LLM_TIMEOUT_SECONDS=120
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_KO_TIMEOUT_SECONDS=20
RISK_PROMPT_TIMEOUT_SECONDS=5

# MAX_REQUEST_BODY_BYTES 기본값은 configs/model_serving.yaml의
# operational_limits.max_request_body_bytes에서 온다. 호스트별 예외가 필요할 때만 주석을 해제한다.
# MAX_REQUEST_BODY_BYTES=<bytes>
# MAIN_LLM_MAX_CONCURRENCY는 active main-model profile의 실제 vLLM
# --max-num-seqs와 별개로 Gateway 자체 admission 한도를 올린다.
# active profile의 --max-num-seqs보다 크게 잡아도 실제 처리량이 바로 늘지는 않는다.
# 대신 두 번째 이후 요청이 Gateway semaphore에서 queue_timeout_seconds 뒤
# QUEUE_TIMEOUT으로 빠르게 실패하지 않고, vLLM scheduler queue에서
# MAIN_LLM_TIMEOUT_SECONDS 범위 안에 대기할 수 있게 한다.
# 이 값만으로 GPU memory/compute를 추가 예약하지는 않으며, 대기가 발생하는 위치만 바꾼다.
# Gateway 재시작만으로 되돌릴 수 있고, image rebuild나 main-model profile switch는 필요 없다.
MAIN_LLM_MAX_CONCURRENCY=4
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_KO_MAX_CONCURRENCY=2
RISK_PROMPT_MAX_CONCURRENCY=1
MAIN_LLM_QUEUE_TIMEOUT_SECONDS=30
EMBEDDING_QUEUE_TIMEOUT_SECONDS=2
EMBEDDING_KO_QUEUE_TIMEOUT_SECONDS=2
RISK_PROMPT_QUEUE_TIMEOUT_SECONDS=2
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
STARTUP_WAIT_SECONDS=45
READY_FULL_TIMEOUT_SECONDS=1800
READY_FULL_INTERVAL_SECONDS=10

# EXPOSURE_MODE: host-published compose port topology를 제어한다.
# canonical modes:
#   master_open (local_open 기본값): 신뢰된 사내망에서 전체 stack host-published
#   private_network: Gateway, Grafana만 host-published
# 참고: `make exposure-status` 또는 `make auth-doctor`로 structured diagnostics를 확인한다.
EXPOSURE_MODE=master_open

# EXPOSURE_AUDIENCE: EXPOSURE_MODE=master_open 시 필수. 누구에게 포트가 열리는지 선언한다.
# allowed values: local_only, private_lan, vpn, public
# - local_only: 127.0.0.1 bind; 개발자 로컬 전용
# - private_lan: 사내망/사설 IP bind; staging/ops 전용
# - vpn: VPN 경계 내부에서만 접근 가능
# - public: internet-reachable (ALLOW_PUBLIC_OPERATIONS_ENDPOINTS=true 추가 필요)
# private_network에서는 선택 사항이다.
EXPOSURE_AUDIENCE=private_lan

# ALLOW_PUBLIC_OPERATIONS_ENDPOINTS: EXPOSURE_AUDIENCE=public 시 명시적 opt-in이 필요하다.
# true로 설정하면 vLLM raw API 및 ops endpoint가 인터넷에 직접 노출된다.
# ALLOW_PUBLIC_OPERATIONS_ENDPOINTS=

# local_open은 외부 접근이 차단된 사내망에서 인증 없이 전체 stack을 사용하는 profile이다.
AUTH_MODE=local_open
API_KEY_REQUIRED=false
ADMIN_API_KEY_REQUIRED=false
# /ready와 /metrics를 app-level auth 대신 내부망/ingress에서 보호할 때만 true로 둔다.
ADMIN_ENDPOINTS_INTERNAL_ONLY=false
# non-local internal_trusted는 network/edge/caller 인증 소유권 증거가 필요하다.
INTERNAL_TRUSTED_AUTH_EVIDENCE=
# non-local custom은 명시적 risk acceptance와 change ticket이 필요하다.
CUSTOM_AUTH_RISK_ACCEPTED=false
CUSTOM_AUTH_RISK_TICKET=
ADMIN_API_KEY=generate-with-make-init-env
ADMIN_API_KEYS=generate-with-make-init-env
API_KEYS=change-me
INTERNAL_SERVICE_TOKEN=change-me-internal
INTERNAL_SERVICE_AUTH_REQUIRED=false
API_KEY=change-me
LOG_PROMPT_BODY=false
LOG_MODEL_RAW_OUTPUT=false

GATEWAY_POLICY_PLUGIN_ENABLED=false
GATEWAY_RISK_MODE=signal_only
PACKAGE_NAME=ai_model_serving_platform

# ops/compose/full-stack.private-network.yaml에서 사용한다. `make init-env-compose`가 안전한 key와 검토된 기본 image tag를 채운다.
# 프로덕션 승격 전에는 mutable tag를 검증된 immutable digest로 교체한다. Replace mutable tags with validated immutable digests before production promotion.
PLATFORM_IMAGE=ai-model-serving-platform:0.0.1
# CI/CD 배포 시 자동으로 설정됩니다 — 직접 수정하지 마세요.
DEPLOY_RELEASE_ID=
VLLM_IMAGE=vllm/vllm-openai:gemma4-0505-cu129
EMBEDDING_KO_VLLM_IMAGE=vllm/vllm-openai:gemma4-0505-cu129
# Risk detector는 Gemma4 runtime과 분리한다. `make build-risk-vllm-image`가 이 이미지를 만든다.
RISK_VLLM_IMAGE=ai-model-serving-risk-vllm-kanana:0.0.1
# 12B 멀티모달 전용 derived 런타임(ops/images/vllm-gemma4-audio)의 immutable digest.
# build-vllm-derived가 빌드 후 CI/deploy가 자동 주입한다(직접 수정 불필요). 비어 있으면
# 12B 프로필은 공유 base 이미지로 fallback하고 audio boot canary가 go-live를 막는다.
AUDIO_VLLM_IMAGE=
RISK_VLLM_BASE_IMAGE=vllm/vllm-openai:gemma4-0505-cu129
RISK_VLLM_TRANSFORMERS_VERSION=4.52.4
RISK_VLLM_TRANSFORMERS_MIN_VERSION=4.52.4
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.5.2-4.8.1-distroless
PROMETHEUS_IMAGE=prom/prometheus:v3-distroless
GRAFANA_IMAGE=grafana/grafana:12.2.8
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate-with-make-init-env
GRAFANA_ANONYMOUS_ENABLED=false

PROMETHEUS_PORT=9410
GRAFANA_PORT=9411
DCGM_EXPORTER_PORT=9412
CADVISOR_PORT=9413
# Bind addresses for host-published services (used by exposure override compose files).
# Default 0.0.0.0 publishes on all interfaces. Use a specific IP to restrict access.
# For EXPOSURE_MODE=master_open with EXPOSURE_AUDIENCE=private_lan, set to your private interface IP.
GRAFANA_BIND_ADDR=0.0.0.0
PROMETHEUS_BIND_ADDR=0.0.0.0
RISK_ADAPTER_BIND_ADDR=0.0.0.0
DCGM_EXPORTER_BIND_ADDR=0.0.0.0
CADVISOR_BIND_ADDR=0.0.0.0
MAIN_LLM_VLLM_BIND_ADDR=0.0.0.0
EMBEDDING_VLLM_BIND_ADDR=0.0.0.0
EMBEDDING_KO_VLLM_BIND_ADDR=0.0.0.0
RISK_PROMPT_VLLM_BIND_ADDR=0.0.0.0
ALERTMANAGER_ENABLED=false
METRICS_RAW_TEXT_LABELS_FORBIDDEN=true

# gated Hugging Face model을 쓰면 필요하다. `make init-env-compose-force`는 기존 운영자 값을 보존한다.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
# vLLM/Hugging Face 다운로드 캐시. compose는 이 host path를 /root/.cache/huggingface로 mount한다.
# Production deploy resolves relative HF_CACHE_DIR values from the compose file directory.
# With COMPOSE_FILE=ops/compose/full-stack.private-network.yaml,
# ./model_cache/huggingface resolves to <deployment-root>/ops/compose/model_cache/huggingface.
HF_CACHE_DIR=./model_cache/huggingface
EMBEDDING_KO_GPU_MEMORY_UTILIZATION=0.06

# ── Infisical 자체 호스팅 시크릿 관리 (make infisical-up) ──────────────
# AUTH_SECRET, ENCRYPTION_KEY는 make init-env-compose 가 자동 생성한다.
# 최초 생성 후 절대 변경 금지 — 변경 시 기존 시크릿 복호화 불가.
INFISICAL_AUTH_SECRET=generate-with-make-init-env
INFISICAL_ENCRYPTION_KEY=generate-with-make-init-env
INFISICAL_PORT=9420
INFISICAL_URL=http://localhost:9420
# make infisical-up 후 웹 UI에서 Organization/Project 생성, Machine Identity 발급 후 채운다.
# 설정 가이드: make infisical-init
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=staging
