{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-serving.local/schemas/performance_run.schema.json",
  "title": "Performance benchmark run result",
  "description": "벤치마크 실행의 원본 증거다(ADR-0026 8·9절). Markdown 보고서는 이 문서에서 파생된다. 환경 지문 없이는 결과를 비교할 수 없으므로 required로 강제한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "run",
    "environment",
    "workload",
    "requests",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "type": "integer",
      "description": "configs/performance/metrics.yaml의 version. 계약이 바뀌면 과거 결과와 직접 비교하지 않는다."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "started_at",
        "duration_seconds",
        "seed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "smoke",
            "baseline",
            "sweep",
            "regression"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "측정 구간의 벽시계 시간. 마지막 요청이 끝나기를 기다린 시간까지 포함한다."
        },
        "dispatch_window_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "첫 요청을 띄운 뒤 마지막 요청을 띄우기까지의 시간. open loop가 실제로 부하를 가한 구간이며 goodput의 분모다. duration_seconds로 나누면 tail drain 때문에 처리량이 과소 평가된다."
        },
        "seed": {
          "type": "integer"
        },
        "measurement_backend": {
          "type": "string",
          "description": "어떤 도구로 측정했는지. 도구는 실행 backend이지 기준이 아니다."
        },
        "sweep_id": {
          "type": "string",
          "minLength": 1,
          "description": "같은 sweep에 속한 실행을 묶는 값. sweep 지점마다 결과 문서를 따로 만든다. 한 문서에 여러 부하의 샘플을 담으면 percentile이 서로 다른 조건의 값을 섞어 계산된다."
        },
        "max_dispatch_lag_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "open loop scheduler가 목표 발사 시각보다 늦은 최대 폭. 이 값이 크면 숫자가 서버가 아니라 부하 생성기를 설명한다."
        },
        "admission_wait_joined_requests": {
          "type": "integer",
          "minimum": 0,
          "description": "접근 로그에서 admission 대기 시간을 이어 붙인 요청 수. 전부 이어지지 않을 수 있다 -- 로그가 회전했거나 아직 flush되지 않았을 수 있다. 이 수 없이 일부만 채우면 그 부분집합으로 계산한 값이 전체를 대표하는 것처럼 읽힌다."
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "지문이 없으면 6개월 뒤 이 숫자를 해석할 수 없다.",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "deployment_target",
        "runtime_backend",
        "model_id",
        "model_revision",
        "platform_image",
        "runtime_flags",
        "runtime_profile"
      ],
      "properties": {
        "git_commit": {
          "type": "string",
          "minLength": 7
        },
        "deployment_target": {
          "type": "string",
          "minLength": 1
        },
        "runtime_backend": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "served_model_name": {
          "type": "string"
        },
        "platform_image": {
          "type": "string",
          "minLength": 1
        },
        "runtime_image": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "runtime_flags": {
          "type": "object",
          "description": "max_model_len, max_num_seqs, speculative decoding, prefix caching 등 결과를 바꾸는 실행 설정.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "gpu": {
          "type": [
            "object",
            "null"
          ],
          "description": "모델을 실행한 가속기. Apple Silicon도 Metal GPU가 있으므로 비우지 않는다. 비워 두면 32GB M5와 128GB M3 Ultra가 같은 지문을 낸다. per_gpu 파생값은 GPU가 없어서가 아니라 memory_kind가 unified일 때 계산하지 않는다.",
          "additionalProperties": false,
          "required": [
            "model",
            "count",
            "memory_kind"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "memory_kind": {
              "enum": [
                "dedicated",
                "unified"
              ],
              "description": "dedicated는 NVIDIA의 전용 VRAM, unified는 Apple Silicon처럼 CPU와 공유하는 메모리다. 같은 memory_bytes라도 의미가 다르다 -- unified는 OS와 다른 프로세스가 같은 풀을 쓴다."
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "driver_version": {
              "type": "string"
            },
            "cuda_version": {
              "type": "string"
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "platform": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "runtime_profile": {
          "type": "string",
          "minLength": 1,
          "description": "실행한 main model profile. 같은 모델이라도 profile마다 max_model_len 등 실행 설정이 달라 결과가 달라진다."
        },
        "accelerator_unavailable_reason": {
          "type": "string",
          "minLength": 1,
          "description": "가속기를 기록하지 못한 이유. benchmark client가 런타임과 다른 기기에 있으면 여기서 관측할 수 없다. 조용히 비우면 가속기가 없는 것으로 읽히고, 이 기기의 것을 적으면 Linux target 결과에 Apple 칩이 들어간다."
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cache_policy",
        "traffic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cache_policy": {
          "enum": [
            "cold",
            "warm",
            "controlled_reuse"
          ]
        },
        "shared_prefix_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "traffic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "open_loop",
                "closed_loop"
              ]
            },
            "request_rate_per_second": {
              "type": "number",
              "minimum": 0
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "admission_limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "이 실행이 보낸 입력 길이. length sweep은 지점마다 다르므로, 계약의 선언이 아니라 실제로 보낸 값을 남긴다."
        }
      }
    },
    "requests": {
      "type": "array",
      "description": "요청별 원시 샘플. percentile은 여기서 계산한다. Prometheus histogram을 판정 근거로 쓰지 않는다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "succeeded"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "succeeded": {
            "type": "boolean"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "status_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream_response_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_time_to_first_chunk_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "client_operation_duration_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "client_time_per_output_chunk_seconds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "minimum": 0
            },
            "description": "출력 chunk 도착 간격. 전송 계층이 chunk를 뭉쳐 보내면 percentile은 서버가 아니라 그 뭉침을 잰다. 합계와 평균만 해석 가능하다."
          },
          "client_time_per_output_token_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "client_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "client_output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "session_index": {
            "type": "integer",
            "minimum": 0,
            "description": "multi turn session에서 이 요청이 속한 세션. 세션마다 고유한 내용이 있어 세션 간에는 공유 prefix만 겹친다."
          },
          "turn_index": {
            "type": "integer",
            "minimum": 0,
            "description": "세션 안에서 몇 번째 턴인가. 0번 턴은 캐시가 비어 있고 그 뒤는 앞 턴의 prefix를 재사용한다. 구분하지 않으면 두 상태의 지연이 한 분포에 섞여 캐시 효과가 평균에 묻힌다."
          },
          "gateway_admission_wait_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Gateway가 admission slot을 기다린 시간. client는 이 값을 볼 수 없고, Gateway는 접근 로그에 queue_wait_ms로만 남긴다. 응답 헤더로 내보내면 내부 타이밍이 공개 API가 되므로, 수집기가 request_id로 접근 로그와 이어 붙여 채운다."
          }
        }
      }
    },
    "runtime_snapshot": {
      "type": "object",
      "description": "Prometheus에서 읽은 런타임·인프라 상태. 판정 근거가 아니라 해석 근거다. 계약이 unsupported로 선언한 조합은 키를 만들지 않는다 -- 없는 series를 물어 빈 값을 받으면 '0이었다'와 구분되지 않는다. counter는 scrape 해상도만큼 거칠다. 92초 구간에서 scrape 8점이면 client 실측과 0.1% 차이였지만, 23초 구간에서 2점이면 절반 넘게 어긋났다. samples가 그 신뢰도다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": [
              "number",
              "null"
            ]
          },
          "end": {
            "type": [
              "number",
              "null"
            ]
          },
          "avg": {
            "type": [
              "number",
              "null"
            ]
          },
          "max": {
            "type": [
              "number",
              "null"
            ]
          },
          "p95": {
            "type": [
              "number",
              "null"
            ]
          },
          "samples": {
            "type": "integer",
            "minimum": 1,
            "description": "이 값을 만든 서로 다른 scrape 점의 수. 적을수록 구간 경계 효과가 크다."
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "evaluator가 원시 샘플에서 계산한 집계값. metric 이름은 계약의 이름만 쓴다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "이 값을 만든 표본 수. percentile이 null이면 slo.yaml의 minimum_samples를 못 채운 것이며, 표본 수 없이는 그 구분이 보이지 않는다."
          },
          "p50": {
            "type": [
              "number",
              "null"
            ]
          },
          "p95": {
            "type": [
              "number",
              "null"
            ]
          },
          "p99": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "min": {
            "type": [
              "number",
              "null"
            ]
          },
          "max": {
            "type": [
              "number",
              "null"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "description": "SLO 판정. enforcement가 observe면 결과가 실행을 실패시키지 않는다.",
      "additionalProperties": false,
      "required": [
        "slo_class",
        "enforcement",
        "status"
      ],
      "properties": {
        "slo_class": {
          "type": "string"
        },
        "enforcement": {
          "enum": [
            "observe",
            "warn",
            "release",
            "required"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_evaluated"
          ]
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "status"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "statistic": {
                "type": "string"
              },
              "observed": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "threshold_source": {
                "enum": [
                  "product_requirement",
                  "declared_limit",
                  "regression_guard",
                  null
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "warn",
                  "fail",
                  "not_evaluated"
                ]
              },
              "not_evaluated_reason": {
                "enum": [
                  "no_threshold",
                  "insufficient_samples",
                  "not_measured"
                ],
                "description": "판정하지 못한 이유. 이유 없는 not_evaluated는 무엇을 고쳐야 하는지 알려주지 않는다. 표본을 더 모으면 되는 것과 임계값을 정해야 하는 것은 다른 작업이다."
              }
            }
          }
        }
      }
    },
    "runtime_snapshot_error": {
      "type": "string",
      "minLength": 1,
      "description": "런타임 상태를 읽지 못한 이유. 수집하지 않은 것과 수집했는데 비어 있던 것은 다르다. 기본 노출 프로필은 Prometheus를 호스트에 공개하지 않으므로 이 값이 채워지는 것이 정상인 환경이 있다."
    },
    "admission_wait_error": {
      "type": "string",
      "minLength": 1,
      "description": "admission 대기 시간을 이어 붙이지 못한 이유. 대기가 0이었던 것과 조인할 로그를 못 찾은 것은 다르다."
    },
    "runtime_snapshot_skipped": {
      "type": "object",
      "description": "읽을 수 있었지만 이 실행에서는 계산할 수 없어 건너뛴 지표와 그 이유. 조용히 비우면 그 구간에 아무 일도 없었던 것으로 읽힌다.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
