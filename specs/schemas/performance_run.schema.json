{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-serving.local/schemas/performance_run.schema.json",
  "title": "Performance benchmark run result",
  "description": "벤치마크 실행의 원본 증거다(ADR-0026 8·9절). Markdown 보고서는 이 문서에서 파생된다. 환경 지문 없이는 결과를 비교할 수 없으므로 required로 강제한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "run", "environment", "workload", "requests", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {
      "type": "integer",
      "description": "configs/performance/metrics.yaml의 version. 계약이 바뀌면 과거 결과와 직접 비교하지 않는다."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "started_at", "duration_seconds", "seed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["smoke", "baseline", "sweep", "regression"]},
        "started_at": {"type": "string", "format": "date-time"},
        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "측정 구간의 벽시계 시간. 마지막 요청이 끝나기를 기다린 시간까지 포함한다."
        },
        "dispatch_window_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "첫 요청을 띄운 뒤 마지막 요청을 띄우기까지의 시간. open loop가 실제로 부하를 가한 구간이며 goodput의 분모다. duration_seconds로 나누면 tail drain 때문에 처리량이 과소 평가된다."
        },
        "seed": {"type": "integer"},
        "measurement_backend": {
          "type": "string",
          "description": "어떤 도구로 측정했는지. 도구는 실행 backend이지 기준이 아니다."
        },
        "max_dispatch_lag_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "open loop scheduler가 목표 발사 시각보다 늦은 최대 폭. 이 값이 크면 숫자가 서버가 아니라 부하 생성기를 설명한다."
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "지문이 없으면 6개월 뒤 이 숫자를 해석할 수 없다.",
      "additionalProperties": false,
      "required": [
        "git_commit", "deployment_target", "runtime_backend",
        "model_id", "model_revision", "platform_image", "runtime_flags"
      ],
      "properties": {
        "git_commit": {"type": "string", "minLength": 7},
        "deployment_target": {"type": "string", "minLength": 1},
        "runtime_backend": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "served_model_name": {"type": "string"},
        "platform_image": {"type": "string", "minLength": 1},
        "runtime_image": {"type": "string"},
        "runtime_version": {"type": "string"},
        "runtime_flags": {
          "type": "object",
          "description": "max_model_len, max_num_seqs, speculative decoding, prefix caching 등 결과를 바꾸는 실행 설정.",
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        },
        "gpu": {
          "type": ["object", "null"],
          "description": "GPU가 없는 target(macOS unified memory)에서는 null이며 per_gpu 파생값을 계산하지 않는다.",
          "additionalProperties": false,
          "required": ["model", "count"],
          "properties": {
            "model": {"type": "string"},
            "count": {"type": "integer", "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 0},
            "driver_version": {"type": "string"},
            "cuda_version": {"type": "string"}
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "platform": {"type": "string"},
            "cpu": {"type": "string"},
            "memory_bytes": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cache_policy", "traffic"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cache_policy": {"enum": ["cold", "warm", "controlled_reuse"]},
        "shared_prefix_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "traffic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["open_loop", "closed_loop"]},
            "request_rate_per_second": {"type": "number", "minimum": 0},
            "concurrency": {"type": "integer", "minimum": 1},
            "admission_limit": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "description": "요청별 원시 샘플. percentile은 여기서 계산한다. Prometheus histogram을 판정 근거로 쓰지 않는다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "succeeded"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "succeeded": {"type": "boolean"},
          "error_code": {"type": ["string", "null"]},
          "status_code": {"type": ["integer", "null"]},
          "request_id": {"type": ["string", "null"]},
          "upstream_response_id": {"type": ["string", "null"]},
          "client_time_to_first_chunk_seconds": {"type": ["number", "null"], "minimum": 0},
          "client_operation_duration_seconds": {"type": ["number", "null"], "minimum": 0},
          "client_time_per_output_chunk_seconds": {
            "type": ["array", "null"],
            "items": {"type": "number", "minimum": 0},
            "description": "출력 chunk 도착 간격. 전송 계층이 chunk를 뭉쳐 보내면 percentile은 서버가 아니라 그 뭉침을 잰다. 합계와 평균만 해석 가능하다."
          },
          "client_time_per_output_token_seconds": {"type": ["number", "null"], "minimum": 0},
          "client_input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "client_output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "gateway_admission_wait_seconds": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Gateway가 admission slot을 기다린 시간. client는 이 값을 볼 수 없고, Gateway는 접근 로그에 queue_wait_ms로만 남긴다. 응답 헤더로 내보내면 내부 타이밍이 공개 API가 되므로, 수집기가 request_id로 접근 로그와 이어 붙여 채운다."
          }
        }
      }
    },
    "runtime_snapshot": {
      "type": "object",
      "description": "Prometheus에서 읽은 런타임·인프라 상태. 계약이 unsupported로 선언한 지표는 키를 만들지 않는다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {"type": ["number", "null"]},
          "end": {"type": ["number", "null"]},
          "avg": {"type": ["number", "null"]},
          "max": {"type": ["number", "null"]},
          "p95": {"type": ["number", "null"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "evaluator가 원시 샘플에서 계산한 집계값. metric 이름은 계약의 이름만 쓴다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "이 값을 만든 표본 수. percentile이 null이면 slo.yaml의 minimum_samples를 못 채운 것이며, 표본 수 없이는 그 구분이 보이지 않는다."
          },
          "p50": {"type": ["number", "null"]},
          "p95": {"type": ["number", "null"]},
          "p99": {"type": ["number", "null"]},
          "mean": {"type": ["number", "null"]},
          "min": {"type": ["number", "null"]},
          "max": {"type": ["number", "null"]},
          "value": {"type": ["number", "null"]}
        }
      }
    },
    "verdict": {
      "type": "object",
      "description": "SLO 판정. enforcement가 observe면 결과가 실행을 실패시키지 않는다.",
      "additionalProperties": false,
      "required": ["slo_class", "enforcement", "status"],
      "properties": {
        "slo_class": {"type": "string"},
        "enforcement": {"enum": ["observe", "warn", "release", "required"]},
        "status": {"enum": ["pass", "warn", "fail", "not_evaluated"]},
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "status"],
            "properties": {
              "metric": {"type": "string"},
              "statistic": {"type": "string"},
              "observed": {"type": ["number", "null"]},
              "threshold": {"type": ["number", "null"]},
              "threshold_source": {"enum": ["product_requirement", "declared_limit", "regression_guard", null]},
              "status": {"enum": ["pass", "warn", "fail", "not_evaluated"]},
              "not_evaluated_reason": {
                "enum": ["no_threshold", "insufficient_samples", "not_measured"],
                "description": "판정하지 못한 이유. 이유 없는 not_evaluated는 무엇을 고쳐야 하는지 알려주지 않는다. 표본을 더 모으면 되는 것과 임계값을 정해야 하는 것은 다른 작업이다."
              }
            }
          }
        }
      }
    }
  }
}
