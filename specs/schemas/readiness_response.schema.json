{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadinessResponse",
  "type": "object",
  "required": [
    "status",
    "service",
    "phase",
    "not_ready_dependencies",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "degraded",
        "not_ready"
      ]
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "serving",
        "waiting_for_dependencies"
      ]
    },
    "not_ready_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded",
              "not_ready",
              "unknown"
            ]
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
