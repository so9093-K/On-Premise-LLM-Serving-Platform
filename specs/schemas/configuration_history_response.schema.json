{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigurationHistoryResponse",
  "type": "object",
  "required": ["items", "next_cursor"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/historyItem"}
    },
    "next_cursor": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "$defs": {
    "historyItem": {
      "type": "object",
      "required": [
        "operation_id",
        "kind",
        "status",
        "phase",
        "actor",
        "request_id",
        "created_at",
        "updated_at",
        "base_revision",
        "candidate_revision",
        "applied_revision",
        "target_revision",
        "would_change",
        "plan_digest",
        "changes",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^cfg_[0-9a-f]{32}$"
        },
        "kind": {
          "type": "string",
          "enum": ["configuration_apply", "configuration_rollback"]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "noop",
            "rejected",
            "apply_failed",
            "recovered_after_restart",
            "interrupted_before_persist",
            "interrupted_state_mismatch"
          ]
        },
        "phase": {"type": "string", "minLength": 1},
        "actor": {
          "type": "object",
          "required": ["auth_method", "actor_id"],
          "additionalProperties": false,
          "properties": {
            "auth_method": {"type": "string", "minLength": 1},
            "actor_id": {"type": "string", "minLength": 1}
          }
        },
        "request_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "number", "minimum": 0},
        "updated_at": {"type": "number", "minimum": 0},
        "base_revision": {"type": "integer", "minimum": 0},
        "candidate_revision": {"type": "integer", "minimum": 0},
        "applied_revision": {"type": ["integer", "null"], "minimum": 0},
        "target_revision": {"type": ["integer", "null"], "minimum": 0},
        "would_change": {"type": "boolean"},
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "configuration_plan_change.schema.json"}
        },
        "verification": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/verification"}
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "store_revision",
        "resolver_revision",
        "runtime_revision",
        "synchronized"
      ],
      "additionalProperties": false,
      "properties": {
        "store_revision": {"type": ["integer", "null"], "minimum": 0},
        "resolver_revision": {"type": "integer", "minimum": 0},
        "runtime_revision": {"type": "integer", "minimum": 0},
        "synchronized": {"type": "boolean"}
      }
    }
  }
}
