{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayRetrievalScoreRequest",
  "type": "object",
  "required": ["query", "documents"],
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "enum": ["local-embed-ko", "local-embed"]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1}
    },
    "score_mode": {
      "type": "string",
      "enum": ["dense_cosine"]
    },
    "truncate_prompt_tokens": {
      "type": "integer",
      "oneOf": [
        {"const": -1},
        {"minimum": 1, "maximum": 2048}
      ]
    },
    "truncation_side": {
      "type": "string",
      "enum": ["left", "right"]
    }
  }
}
