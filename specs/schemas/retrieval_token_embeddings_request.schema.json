{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayRetrievalTokenEmbeddingsRequest",
  "type": "object",
  "required": ["model", "texts"],
  "additionalProperties": false,
  "properties": {
    "model": {
      "const": "local-colbert-ko"
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string"}
    },
    "truncate_to_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 192
    }
  }
}
