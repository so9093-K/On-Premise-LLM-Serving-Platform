{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-serving.local/schemas/performance_baseline.schema.json",
  "title": "Promoted performance baseline",
  "description": "특정 구성에서 관찰된 known-good 성능이다(ADR-0026 1·9절). SLO가 아니다 -- SLO는 제공하려는 품질이고 이것은 관찰이다. 벤치마크 실행이 이 파일을 자동으로 덮어쓰지 않는다. 자동 갱신되면 성능이 서서히 나빠져도 baseline이 따라 내려가 회귀를 영원히 못 잡는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "configuration",
    "provenance",
    "statistics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "type": "integer",
      "description": "승격 당시 metrics.yaml의 version. 계약이 바뀌면 이 baseline과 직접 비교하지 않는다."
    },
    "configuration": {
      "type": "object",
      "description": "이 baseline이 유효한 구성. 값을 정하는 것은 모델과 런타임 설정이며 target 이름이 아니다. 가속기는 키에 넣지 않는다 -- benchmark client가 원격이면 관측되지 않고, 하드웨어 종류는 deployment_target이 이미 정한다. 회귀 비교는 이 항목이 모두 일치하는 실행에만 적용된다.",
      "additionalProperties": false,
      "required": [
        "runtime_backend",
        "runtime_profile",
        "model_id",
        "model_revision"
      ],
      "properties": {
        "runtime_backend": {
          "type": "string",
          "minLength": 1
        },
        "deployment_target": {
          "type": "string",
          "minLength": 1
        },
        "runtime_profile": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "request_rate_per_second": {
          "type": "number",
          "minimum": 0,
          "description": "부하가 값을 바꾸는 지표가 있으면 이 baseline은 이 부하에서만 유효하다. 다른 부하의 실행과 비교하면 대기열 길이를 성능 변화로 읽는다."
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "어느 실행에서 왔는지. 없으면 이 숫자를 다시 만들 수 없고, 무엇과 비교하는지도 알 수 없다.",
      "additionalProperties": false,
      "required": [
        "run_ids",
        "git_commit",
        "promoted_at",
        "promoted_by"
      ],
      "properties": {
        "run_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "승격에 사용한 실행. 여럿이면 statistics가 그 실행들의 편차를 함께 담는다."
        },
        "git_commit": {
          "type": "string",
          "minLength": 7
        },
        "platform_image": {
          "type": "string"
        },
        "promoted_at": {
          "type": "string",
          "format": "date-time"
        },
        "promoted_by": {
          "type": "string",
          "minLength": 1,
          "description": "사람이 명시적으로 승격한다. 도구가 스스로 올리지 않는다."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "statistics": {
      "type": "object",
      "description": "승격된 관찰값. 최소 표본을 못 채운 통계는 넣지 않는다 -- 표본이 적으면 사실상 최댓값이고, 다음 실행이 표본을 더 모으면 그것만으로 회귀가 된다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "samples"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "samples": {
              "type": "integer",
              "minimum": 1
            },
            "observed_spread_ratio": {
              "type": "number",
              "minimum": 0,
              "description": "여러 실행에서 승격했을 때 관찰된 편차. 허용 오차가 이 값보다 작으면 정상 변동을 회귀로 잡는다."
            }
          }
        }
      }
    }
  }
}
