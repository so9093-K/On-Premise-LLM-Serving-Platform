{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigurationEffectiveResponse",
  "type": "object",
  "required": ["version", "revision", "items", "write_status"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "revision": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "write_status": {"$ref": "#/$defs/write_status"}
  },
  "$defs": {
    "write_status": {
      "type": "object",
      "required": [
        "available",
        "reason",
        "store_revision",
        "resolver_revision",
        "runtime_revision",
        "synchronized",
        "pending_operations"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "store_revision": {"type": ["integer", "null"], "minimum": 0},
        "resolver_revision": {"type": "integer", "minimum": 0},
        "runtime_revision": {"type": "integer", "minimum": 0},
        "synchronized": {"type": "boolean"},
        "pending_operations": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "item": {
      "type": "object",
      "required": [
        "key",
        "effective_value",
        "effective_source",
        "owner",
        "control_surface",
        "editable",
        "sensitive"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "default_value": {},
        "operator_value": {},
        "effective_value": {},
        "effective_source": {
          "type": "string",
          "enum": ["repository", "operator", "deployment", "runtime", "secret"]
        },
        "owner": {
          "type": "string",
          "enum": ["repository", "operator", "deployment", "runtime", "secret"]
        },
        "control_surface": {
          "type": "string",
          "enum": ["configuration", "deployment", "runtime", "main_model", "secret", "access_profile", "repository"]
        },
        "editable": {"type": "boolean"},
        "sensitive": {"type": "boolean"},
        "operator_override_shadowed": {"type": "boolean"},
        "configured": {"type": "boolean"}
      }
    }
  }
}
