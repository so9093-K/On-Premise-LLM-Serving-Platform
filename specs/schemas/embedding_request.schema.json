{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayEmbeddingRequest",
  "type": "object",
  "required": ["model", "input"],
  "additionalProperties": false,
  "properties": {
    "model": {"enum": ["local-embed", "local-embed-ko"]},
    "input": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "minItems": 1, "items": {"type": "string"}}
      ]
    },
    "dimensions": {
      "type": "integer",
      "oneOf": [
        {"const": 768},
        {"const": 1024}
      ]
    },
    "encoding_format": {"type": "string", "const": "float"},
    "truncate_prompt_tokens": {
      "type": "integer",
      "oneOf": [
        {"const": -1},
        {"minimum": 1, "maximum": 2048}
      ]
    },
    "user": {
      "description": "OpenAI API compatibility용 optional 식별자. Gateway에서 accept하되 upstream에 전달 여부는 runtime profile에 따른다. metric label로 사용하지 않는다. response에 영향 없음.",
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"model": {"const": "local-embed-ko"}}, "required": ["model"]},
      "then": {
        "properties": {
          "dimensions": {"const": 1024}
        }
      }
    },
    {
      "if": {"properties": {"model": {"const": "local-embed"}}, "required": ["model"]},
      "then": {
        "properties": {
          "dimensions": {"const": 768}
        }
      }
    }
  ]
}
