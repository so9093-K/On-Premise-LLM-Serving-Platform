{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigurationChanges",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": ["key", "op", "value"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "op": {"const": "set"},
          "value": {}
        }
      },
      {
        "type": "object",
        "required": ["key", "op"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "op": {"const": "reset"}
        }
      }
    ]
  }
}