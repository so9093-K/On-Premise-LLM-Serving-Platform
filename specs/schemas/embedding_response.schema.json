{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayEmbeddingResponse",
  "type": "object",
  "required": [
    "object",
    "data",
    "model"
  ],
  "additionalProperties": true,
  "properties": {
    "object": {
      "const": "list"
    },
    "model": {
      "type": "string",
      "enum": [
        "local-embed",
        "local-embed-ko"
      ]
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object",
          "embedding",
          "index"
        ],
        "additionalProperties": true,
        "properties": {
          "object": {
            "const": "embedding"
          },
          "embedding": {
            "description": "encoding_format=float이면 숫자 배열, encoding_format=base64이면 little-endian float32 배열을 base64로 인코딩한 문자열이다.",
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "usage": {
      "type": "object"
    }
  }
}
