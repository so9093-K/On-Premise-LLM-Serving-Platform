{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigurationApplyRequest",
  "type": "object",
  "required": ["plan_digest", "changes"],
  "additionalProperties": false,
  "properties": {
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "$ref": "configuration_changes.schema.json"
    }
  }
}