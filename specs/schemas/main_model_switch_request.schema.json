{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MainModelSwitchRequest",
  "type": "object",
  "required": [
    "profile"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "confirm_unverified": {
      "type": "boolean",
      "default": false
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  }
}
