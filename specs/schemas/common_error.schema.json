{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommonErrorResponse",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "METHOD_NOT_ALLOWED",
            "CONFLICT",
            "GPU_BUDGET_EXCEEDED",
            "MODEL_UNAVAILABLE",
            "MODEL_CAPABILITY_MISMATCH",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_ERROR",
            "UPSTREAM_RESPONSE_INVALID",
            "STRUCTURED_OUTPUT_INVALID",
            "RATE_LIMITED",
            "INTERNAL_ERROR",
            "QUEUE_TIMEOUT",
            "CIRCUIT_OPEN",
            "REQUEST_TOO_LARGE",
            "DETECTOR_DISABLED",
            "STREAM_LIMIT_EXCEEDED",
            "MAIN_MODEL_CONTROL_UNAVAILABLE",
            "MAIN_MODEL_SWITCH_IN_PROGRESS"
          ]
        },
        "message": {
          "type": "string"
        },
        "param": {
          "description": "The request field that caused the error (e.g. 'response_format.json_schema' for a wrong output spec vs 'input_audio.format' for a wrong input data format). Present only for field-scoped validation errors; OpenAI-compatible.",
          "type": ["string", "null"]
        },
        "retryable": {
          "description": "The condition may be transient. Automatic replay also requires operation-specific replay safety and must respect Retry-After when present.",
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        },
        "operation_id": {
          "type": ["string", "null"]
        },
        "operation_status": {
          "type": ["string", "null"]
        },
        "details": {
          "description": "Structured recovery information for an operation-specific error. For GPU_BUDGET_EXCEEDED, includes feasible, required, available, ceiling, and optionally plan.stop.",
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
