{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommonErrorResponse",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "CONFLICT",
            "GPU_BUDGET_EXCEEDED",
            "MODEL_UNAVAILABLE",
            "MODEL_CAPABILITY_MISMATCH",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_ERROR",
            "UPSTREAM_SCHEMA_ERROR",
            "RATE_LIMITED",
            "PARSE_ERROR",
            "INTERNAL_ERROR",
            "QUEUE_TIMEOUT",
            "CIRCUIT_OPEN",
            "REQUEST_TOO_LARGE",
            "RUNTIME_NOT_READY",
            "DETECTOR_RETIRED",
            "DETECTOR_DISABLED",
            "STREAM_LIMIT_EXCEEDED",
            "MAIN_MODEL_CONTROL_UNAVAILABLE",
            "MAIN_MODEL_SWITCH_IN_PROGRESS"
          ]
        },
        "message": {
          "type": "string"
        },
        "param": {
          "description": "The request field that caused the error (e.g. 'response_format.json_schema' for a wrong output spec vs 'input_audio.format' for a wrong input data format). Present only for field-scoped validation errors; OpenAI-compatible.",
          "type": ["string", "null"]
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        },
        "operation_id": {
          "type": ["string", "null"]
        },
        "operation_status": {
          "type": ["string", "null"]
        },
        "debug": {
          "description": "Diagnostic details for operators and internal developers. Values are bounded strings/scalars and may include the original exception summary or upstream status/body snippet.",
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "details": {
          "description": "Structured recovery information for an operation-specific error. For GPU_BUDGET_EXCEEDED, includes feasible, required, available, ceiling, and optionally plan.stop.",
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
