{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayRetrievalRerankRequest",
  "type": "object",
  "required": ["query", "documents"],
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "enum": ["local-colbert-ko", "local-embed"]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1}
    },
    "score_mode": {
      "type": "string",
      "enum": ["dense_cosine", "late_interaction_maxsim"]
    }
  }
}
