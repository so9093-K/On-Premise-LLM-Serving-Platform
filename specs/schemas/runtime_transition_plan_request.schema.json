{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeTransitionPlanRequest",
  "type": "object",
  "required": ["desired_state"],
  "additionalProperties": false,
  "properties": {
    "desired_state": {
      "type": "string",
      "enum": ["active", "stopped"]
    },
    "force": {
      "type": "boolean",
      "default": false
    }
  }
}