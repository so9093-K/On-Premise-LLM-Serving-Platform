{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigurationRollbackPlanResponse",
  "type": "object",
  "required": [
    "kind",
    "target_revision",
    "base_revision",
    "candidate_revision",
    "would_change",
    "changes",
    "plan_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "configuration_rollback"},
    "target_revision": {"type": "integer", "minimum": 0},
    "base_revision": {"type": "integer", "minimum": 0},
    "candidate_revision": {"type": "integer", "minimum": 0},
    "would_change": {"type": "boolean"},
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "configuration_plan_change.schema.json"}
    }
  }
}
