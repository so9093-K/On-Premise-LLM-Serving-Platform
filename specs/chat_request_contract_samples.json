{
  "description": "chat/completions 요청 계약의 두 구현(공개 JSON Schema와 런타임 검증기)을 같은 샘플로 함께 돌리기 위한 corpus다. 각 payload는 파라미터만 담고 model 이름은 싣지 않는다 -- 검증기가 configs/main_model_profiles.yaml의 public_model을 주입한다. 이름을 여기 적어두면 public_model이 바뀔 때 모든 샘플이 조용히 거부되고, 그러면 '런타임이 받는데 스키마가 거부' 검사가 아무것도 확인하지 않게 된다.",
  "samples": [
    {
      "name": "stream_with_usage_option",
      "expect": "accept",
      "payload": {
        "stream": true,
        "stream_options": {
          "include_usage": true
        },
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      }
    },
    {
      "name": "response_format_json_object",
      "expect": "accept",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "Return JSON."
          }
        ],
        "response_format": {
          "type": "json_object"
        }
      }
    },
    {
      "name": "response_format_json_schema",
      "expect": "accept",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "Return JSON."
          }
        ],
        "response_format": {
          "type": "json_schema",
          "json_schema": {
            "name": "answer",
            "strict": true,
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "answer": {
                  "type": "string"
                }
              },
              "required": [
                "answer"
              ]
            }
          }
        }
      }
    },
    {
      "name": "logprobs_with_top_logprobs",
      "expect": "accept",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "logprobs": true,
        "top_logprobs": 10
      }
    },
    {
      "name": "logit_bias_numeric_value",
      "expect": "accept",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "logit_bias": {
          "42": -1.5
        }
      }
    },
    {
      "name": "stream_must_be_boolean",
      "expect": "reject",
      "payload": {
        "stream": "true",
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      }
    },
    {
      "name": "include_usage_must_be_boolean",
      "expect": "reject",
      "payload": {
        "stream": true,
        "stream_options": {
          "include_usage": "yes"
        },
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      }
    },
    {
      "name": "stream_options_requires_stream",
      "expect": "reject",
      "payload": {
        "stream_options": {
          "include_usage": true
        },
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      }
    },
    {
      "name": "stream_options_requires_stream_true",
      "expect": "reject",
      "payload": {
        "stream": false,
        "stream_options": {
          "include_usage": true
        },
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      }
    },
    {
      "name": "user_message_may_not_carry_tool_calls",
      "expect": "reject",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello",
            "tool_calls": []
          }
        ]
      }
    },
    {
      "name": "unsupported_response_format_type",
      "expect": "reject",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "response_format": {
          "type": "xml"
        }
      }
    },
    {
      "name": "text_response_format_may_not_carry_json_schema",
      "expect": "reject",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "response_format": {
          "type": "text",
          "json_schema": {
            "name": "x",
            "schema": {}
          }
        }
      }
    },
    {
      "name": "top_logprobs_below_range",
      "expect": "reject",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "top_logprobs": 0
      }
    },
    {
      "name": "top_logprobs_above_range",
      "expect": "reject",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "logprobs": true,
        "top_logprobs": 11
      }
    },
    {
      "name": "logit_bias_key_must_be_token_id",
      "expect": "reject",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "logit_bias": {
          "x": 1
        }
      }
    },
    {
      "name": "logit_bias_value_must_be_number",
      "expect": "reject",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ],
        "logit_bias": {
          "1": true
        }
      }
    }
  ]
}
